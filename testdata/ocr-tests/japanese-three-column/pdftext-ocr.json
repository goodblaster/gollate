    },
    "normalized_conf": 1,
    "engine": "pdftext"
  },
  {
    "text": "毎週土曜日の午前6時30",
    "bounds": {
      "top": 0.15505268267341019,
      "left": 0.11764705392156861,
      "width": 0.18000383929059288,
      "height": 0.012623105439946337
    },
    "normalized_conf": 1,
    "engine": "pdftext"
  },
  {
    "text": "分、",
    "bounds": {
      "top": 0.15505268267341019,
      "left": 0.2976508861272911,
      "width": 0.032671551538807915,
      "height": 0.012623105439946337
    },
    "normalized_conf": 1,
    "engine": "pdftext"
  },
  {
    "text": "最初の客が来るずっと前から、",
    "bounds": {
      "top": 0.17399207582366275,
      "left": 0.11764705392156861,
      "width": 0.22641375351523552,
      "height": 0.012623105439946337
    },
    "normalized_conf": 1,
    "engine": "pdftext"
  },
  {
